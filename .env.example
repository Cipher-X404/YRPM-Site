# Copy to .env.local for development, or set these in your host's dashboard.
# Never commit real credentials.

# --- Admin access -------------------------------------------------------------
# The only account allowed into /dashboard.
ADMIN_EMAIL=admin@example.com

# Option A (recommended): scrypt hash + salt.
# Generate both with:  npm run admin:hash -- "a long passphrase"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

# Option B (quick start, plain text): leave the hash/salt empty and use this.
ADMIN_PASSWORD=

# Signs the admin session cookie. 32+ random characters.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# How long an admin session lasts. Defaults to 8. Max 72.
ADMIN_SESSION_HOURS=8

# --- Notes --------------------------------------------------------------------
# In development only, if no credentials are set, the login page shows a demo
# account (admin@yrpm.local / studio-preview). Production with no credentials
# locks the studio completely instead of falling back to a default password.
